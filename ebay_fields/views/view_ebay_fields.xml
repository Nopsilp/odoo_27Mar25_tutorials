<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_inheritance_product_template_form" model="ir.ui.view">
            <field name="name">view.inheritance.product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales']" position="inside">
                    <group string="eBay">
                        <field name="ebay_item_number"/>
                        <field name="ebay_listing_status"/>
                        <field name="ebay_price"/>
                        <field name="ebay_stock"/>
                        <field name="ebay_listing_url" widget='url'/>
                    </group>
                </xpath>
            </field>            
        </record>
    </data>
</odoo>
