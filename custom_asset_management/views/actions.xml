<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Action asset.category -->
        <record id="action_asset_category" model="ir.actions.act_window">
            <field name="name">Manage Asset Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">asset.category</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_asset_category_search" />
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No asset categories found. Click here to create a new one.
                </p>
            </field>
        </record>


        <!-- Action asset.asset -->
        <record id="action_asset_asset" model="ir.actions.act_window">
            <field name="name">Manage Asset Asset</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">asset.asset</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_value': 1}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No asset found. Click here to create a new one.
                </p>
            </field>
        </record>

    </data>
</odoo>
