<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- View asset.category List -->
        <record id="view_asset_category_list" model="ir.ui.view">
            <field name="name">view.asset.category.list</field>
            <field name="model">asset.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- View asset.category form -->
        <record id="view_asset_category_form" model="ir.ui.view">
            <field name="name">view.asset.category.form</field>
            <field name="model">asset.category</field>
            <field name="arch" type="xml">
                <form string="Asset Category">
                    <sheet>
                        <!-- Section Title -->
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Enter Category Name..."/>
                            </h1>
                        </div>

                        <!-- Main Content -->
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- View for asset.category search -->
        <record id="view_asset_category_search" model="ir.ui.view">
            <field name="name">view.asset.category.search</field>
            <field name="model">asset.category</field>
            <field name="arch" type="xml">
                <search string='Asset Category Search String'>
                    <!-- ค้นหาตามฟิลด์ Category Name -->
                    <field name="name"/>

                    <!-- ค้นหาตามคำอธิบาย -->
                    <field name="description"/>


                    <filter string="Category: Furniture" name="category_furniture" domain="[('name', '=', 'Furniture')]" />

                    <!-- กำหนดการจัดกลุ่มข้อมูล (Group By) -->
                    <group expand="1" string="Group By">
                        <filter string="Category Name" name="group_by_category" domain="[]" context="{'group_by': 'name'}"/>
                    </group>
                </search>
            </field>
        </record>


        

    </data>
</odoo>
