<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- View asset.asset View List -->
        <record id="view_asset_asset_list" model="ir.ui.view">
            <field name="name">view.asset.asset.list</field>
            <field name="model">asset.asset</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="value"/>
                    <field name="current_value"/>
                    <field name="employee_id"/>
                </list>
            </field>
        </record>

        <!-- View asset.asset form -->
        <record id="view_asset_asset_form" model="ir.ui.view">
            <field name="name">view.asset.asset.form</field>
            <field name="model">asset.asset</field>
            <field name="arch" type="xml">
                <form string="Asset Asset">
                    <sheet>
                        <!-- Section Title -->
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Name..."/>
                            </h1>
                        </div>

                        <!-- Main Content -->
                        <group>
                            <field name="category_id"/>
                            <field name="value"/>
                            <field name="purchase_date"/>
                            <field name="depreciation_rate"/>
                            <field name="current_value"/>
                            <field name="employee_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- View asset.asset search -->
        <record id="view_asset_asset_search" model="ir.ui.view">
            <field name="name">view.asset.asset.search</field>
            <field name="model">asset.asset</field>
            <field name="arch" type="xml">
                <search>

                    <field name='name' />

                    <!-- ค้นหาตามประเภทสินทรัพย์ -->
                    <field name="category_id"/>
                    
                    <!-- Search by both value and current value -->
                    <field name='value' string='Value and Current Value' filter_domain="['|', ('value', '=', self), ('current_value', '=', self)]" />

                    
                    <!-- ค้นหาตามพนักงานที่รับผิดชอบ -->
                    <field name="employee_id"/>
                    
                    <!-- การจัดกลุ่มข้อมูล (Group By) -->
                    <group expand="1" string="Group By">
                        <filter string="Category" name="group_by_category" domain="[]" context="{'group_by': 'category_id'}"/>
                        <filter string="Responsible Employee" name="group_by_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    </group>

                    <!-- Searchpanel for Category -->
                    <searchpanel>
                        <field name='category_id' string='By Category' enable_counters='1'/>
                    </searchpanel>
                </search>
            </field>
        </record>


    </data>
</odoo>
